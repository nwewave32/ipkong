<?xml version="1.0" encoding="utf-8"?>
<!--
  상태바 알림 아이콘 — 잎콩 새싹 글리프의 실루엣.

  Android 5.0+ 는 **알파 채널만 읽어** 단색으로 칠한다. 색을 넣어도 무시되고,
  반대로 ic_launcher 처럼 불투명한 배경이 있는 그림을 쓰면 상태바에 흰
  사각형만 뜬다. 그래서 배경 없이 글리프만 남긴다.

  좌표는 앱 아이콘 원본(1024px)에서 글리프를 재어 24dp 로 옮긴 것이다.
  원본 마스크와 93% 겹친다. 아래 두 가지는 **일부러 다르다**:

  - 콩 왼쪽 아래의 작은 잎 결각을 뺐다. 24dp 에서는 얼룩으로만 보인다.
  - 잎 아래쪽 곡선을 줄기 **안쪽**(x 7.20 < 줄기 오른쪽 7.66)에서 닫는다.
    바깥에서 닫으면 닫는 직선이 빈 공간을 가로질러 얇은 쐐기가 생긴다.

  글리프는 세로 22dp(위아래 1dp 여백)로, 가로는 가운데 맞춤이다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 줄기 — 양 끝이 완전히 둥근 세로 막대 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.94,2.36
                          A1.36,1.36 0 0 1 7.66,2.36
                          L7.66,21.61
                          A1.36,1.36 0 0 1 4.94,21.61
                          Z" />

    <!-- 콩 — 줄기 뒤로 물려 붙는다 (원본에서 둘은 이어져 있다) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.29,17.19
                          A5.44,4.85 0 1 0 18.17,17.19
                          A5.44,4.85 0 1 0 7.29,17.19
                          Z" />

    <!-- 잎 — 줄기에서 오른쪽 위로 뻗어 끝이 뭉툭하게 말린다 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.20,6.00
                          C8.40,4.40 10.60,2.50 13.30,1.55
                          C15.60,0.75 18.40,0.55 18.85,2.10
                          C19.20,3.60 18.00,5.80 16.20,7.10
                          C14.30,8.50 10.50,9.30 7.20,8.60
                          Z" />
</vector>
