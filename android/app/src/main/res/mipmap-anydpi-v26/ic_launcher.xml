<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ 적응형 아이콘. 런처가 원·둥근사각·스쿼클 등 제 모양으로
     마스크하므로, 전경은 108dp 캔버스의 **가운데 72dp 안에만** 그려야
     한다 (icongen.swift 가 2/3 로 줄여 넣는다). 바깥 1/3 은 잘려나가는
     여백이고, 시차 효과를 줄 때 드러나는 영역이기도 하다.

     이 파일이 없으면 Android 8+ 에서 레거시 ic_launcher.png 가 흰 원 안에
     축소돼 들어가 테두리가 생긴다. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
