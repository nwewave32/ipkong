<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 는 windowBackground 를 무시하고 시스템 스플래시를 띄운다.
  이 파일이 없으면 기본 흰 바탕에 런처 아이콘이 뜨므로, 11 이하와 다른
  화면이 된다.

  아이콘은 적응형 아이콘 전경을 그대로 쓴다. 안쪽 2/3 에 그림이 들어
  있어 시스템이 요구하는 비율(288dp 캔버스 · 192dp 가시 영역)과 같고,
  전경이 품고 있는 녹색 사각형은 같은 색 배경에 묻혀 보이지 않는다 —
  결과적으로 녹색 바탕에 글리프만 남는다.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
