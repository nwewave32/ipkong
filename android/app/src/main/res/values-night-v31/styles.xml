<?xml version="1.0" encoding="utf-8"?>
<!--
  values-night 와 values-v31 둘 다 있을 때, Android 12+ 를 **다크 모드로**
  쓰는 기기는 values-night 를 고른다 — 리소스 한정자 우선순위에서 야간 모드가
  플랫폼 버전보다 앞선다. 그래서 이 조합이 없으면 다크 모드에서만 스플래시
  설정이 통째로 빠져 시스템 기본 화면이 뜬다.

  스플래시는 밝기와 무관하게 브랜드 녹색이므로 값은 values-v31 과 같다.
  다른 것은 부모 테마뿐이다.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
